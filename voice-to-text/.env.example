# Voice-to-Text Configuration
# Architecture: Provider-agnostic transcription service

# ============================================
# TRANSCRIPTION PROVIDER (STRATEGIC)
# ============================================
# Which transcription service to use
# This is the top-level architectural switch
#
# Options:
#   google  - Google Cloud Speech-to-Text (implemented)
#   whisper - OpenAI Whisper (not yet implemented)
#   assemblyai - AssemblyAI (not yet implemented)
#   deepgram - Deepgram (not yet implemented)
STT_PROVIDER=google

# ============================================
# GOOGLE CLOUD CONFIGURATION (TACTICAL)
# Only used when STT_PROVIDER=google
# ============================================

# Authentication - Path to service account JSON key
# Download from: https://console.cloud.google.com/iam-admin/serviceaccounts
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account-key.json

# Project ID
GOOGLE_CLOUD_PROJECT=your-project-id

# Cloud Storage Bucket for batch transcription
# Create at: https://console.cloud.google.com/storage
# Required for Google's batch API (handles long audio)
GCS_BUCKET_NAME=your-bucket-name

# Model Selection
# Determines accuracy vs cost tradeoff
#
# Options:
#   long    - Optimized for long audio ($0.024/min) - RECOMMENDED
#   chirp_3 - Best accuracy, multilingual, speaker ID ($0.064/min)
#   short   - Optimized for clips <30 seconds ($0.024/min)
#
# Cost comparison for 1,200 min/month:
#   long:    ~$27/month (after 60 min free tier)
#   chirp_3: ~$73/month (after 60 min free tier)
GOOGLE_MODEL=long

# ============================================
# WHISPER CONFIGURATION (TACTICAL)
# Only used when STT_PROVIDER=whisper
# Not yet implemented - placeholder for future
# ============================================
# WHISPER_MODEL=base
# WHISPER_DEVICE=cpu
# WHISPER_LANGUAGE=en

# ============================================
# NOTES ON ARCHITECTURE
# ============================================
# - STT_PROVIDER is STRATEGIC: defines which service we use
# - Provider-specific settings are TACTICAL: implementation details
# - Google always uses V2 batch API (handles any audio length)
# - V1 API kept in codebase for reference only, not user-facing
