# Voice-to-Text Configuration

# STT API Version (v1 or v2)
# v1: Quick synchronous API (max 60 seconds)
# v2: Batch recognition (any length, requires Cloud Storage)
STT_API_VERSION=v2

# Google Cloud Configuration
# Path to your service account JSON key file
# Download from: https://console.cloud.google.com/iam-admin/serviceaccounts
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account-key.json

# Google Cloud Project ID
GOOGLE_CLOUD_PROJECT=your-project-id

# Cloud Storage Bucket (required for V2 batch recognition)
# Create at: https://console.cloud.google.com/storage
GCS_BUCKET_NAME=voice-to-text-audio-yourname

# STT Model Selection
# Options: chirp_3, long, short
# chirp_3: Best accuracy, multilingual ($0.064/min)
# long: Optimized for long audio ($0.024/min) - RECOMMENDED
# short: For clips <30 seconds ($0.024/min)
STT_MODEL=long
