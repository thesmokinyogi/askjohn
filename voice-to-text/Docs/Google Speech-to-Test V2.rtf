\fs28 \cf9 \cb7 \strokec9 from\cf3 \strokec3  google.cloud.speech_v2 \cf9 \strokec9 import\cf3 \strokec3  SpeechClient\
\cf9 \strokec9 from\cf3 \strokec3  google.api_core.client_options \cf9 \strokec9 import\cf3 \strokec3  ClientOptions\
\cf9 \strokec9 from\cf3 \strokec3  google.cloud.speech_v2.types \cf9 \strokec9 import\cf3 \strokec3  GetConfigRequest\
\cf9 \strokec9 import\cf3 \strokec3  os\
\
PROJECT_ID = os.getenv(\cf10 \strokec10 "GOOGLE_CLOUD_PROJECT"\cf3 \strokec3 , \cf10 \strokec10 "your-project-id"\cf3 \strokec3 )\
\
\cf9 \strokec9 def\cf3 \strokec3  \cf11 \strokec11 get_regional_config\cf3 \strokec3 (project_id: \cf12 \strokec12 str\cf3 \strokec3 , location: \cf12 \strokec12 str\cf3 \strokec3 ):\
    \cf10 \strokec10 """\
    Retrieves the configuration object for a specific Speech-to-Text V2 region.\
    Requires client initialization to the corresponding regional endpoint.\
    """\cf3 \strokec3 \
    \cf9 \strokec9 try\cf3 \strokec3 :\
        \cf13 \strokec13 # 1. Initialize client with regional endpoint\cf3 \strokec3 \
        \cf13 \strokec13 # This aligns the network path with the requested resource location.\cf3 \strokec3 \
        client = SpeechClient(\
            client_options=ClientOptions(\
                api_endpoint=\cf10 \strokec10 f"\cf2 \strokec2 \{location\}\cf10 \strokec10 -speech.googleapis.com"\cf3 \strokec3 ,\
            )\
        )\
    \cf9 \strokec9 except\cf3 \strokec3  Exception \cf9 \strokec9 as\cf3 \strokec3  e:\
        print(\cf10 \strokec10 f"Failed to initialize client for \cf2 \strokec2 \{location\}\cf10 \strokec10 : \cf2 \strokec2 \{e\}\cf10 \strokec10 "\cf3 \strokec3 )\
        \cf9 \strokec9 return\cf3 \strokec3  \cf14 \strokec14 None\cf3 \strokec3 \
        \
    \cf13 \strokec13 # 2. Define the config resource name\cf3 \strokec3 \
    config_name = \cf10 \strokec10 f"projects/\cf2 \strokec2 \{project_id\}\cf10 \strokec10 /locations/\cf2 \strokec2 \{location\}\cf10 \strokec10 /config"\cf3 \strokec3 \
    \
    request = GetConfigRequest(name=config_name)\
    \
    \cf13 \strokec13 # 3. Call the API\cf3 \strokec3 \
    \cf9 \strokec9 try\cf3 \strokec3 :\
        config_response = client.get_config(request=request)\
        print(\cf10 \strokec10 f"Successfully retrieved config for \cf2 \strokec2 \{location\}\cf10 \strokec10 ."\cf3 \strokec3 )\
        \cf9 \strokec9 return\cf3 \strokec3  config_response\
    \cf9 \strokec9 except\cf3 \strokec3  Exception \cf9 \strokec9 as\cf3 \strokec3  e:\
        \cf13 \strokec13 # Catches errors like 404 (location invalid) or permission errors.\cf3 \strokec3 \
        print(\cf10 \strokec10 f"Error retrieving config for \cf2 \strokec2 \{location\}\cf10 \strokec10 : \cf2 \strokec2 \{e\}\cf10 \strokec10 "\cf3 \strokec3 )\
        \cf9 \strokec9 return\cf3 \strokec3  \cf14 \strokec14 None\cf3 \strokec3 \
\
