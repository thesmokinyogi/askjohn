#!/bin/bash
# COGSPACE v40.0.0
# Crystal Palace COGSPACE Command Help System
# Usage: help [command-name] [category]

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
MAGENTA='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m'

# Project context
PROJECT_NAME=$(basename "$(pwd)")
TIMESTAMP=$(date -u +"%Y-%m-%dT%H:%M:%SZ")

show_main_help() {
    echo -e "${CYAN}🏛️ CRYSTAL PALACE COGSPACE COMMAND SYSTEM${NC}"
    echo -e "${BLUE}Project: ${PROJECT_NAME}${NC}"
    echo -e "${BLUE}Timestamp: ${TIMESTAMP}${NC}"
    echo ""
    echo -e "${YELLOW}📋 AVAILABLE COMMANDS:${NC}"
    echo ""
    
    echo -e "${GREEN}🔧 SESSION MANAGEMENT:${NC}"
    echo "  wake.sh                    - Start development session with cognitive restoration"
    echo "  save.sh                    - Save context during development (hardware failure protection)"
    echo "  sleep.sh                   - End session with complete cognitive preservation"
    echo ""
    
    echo -e "${GREEN}📊 REPORTING & TRACKING:${NC}"
    echo "  help-me-bob                - Create trouble reports for issues and bugs"
    echo "  update-bob                 - Report project progress and achievements"
    echo "  status-bob                 - Report system health and deployment status"
    echo ""
    
    echo -e "${GREEN}🏗️ PROJECT MANAGEMENT:${NC}"
    echo "  create-project-bob         - Create new Crystal Palace projects"
    echo ""
    
    echo -e "${GREEN}📚 KNOWLEDGE MANAGEMENT:${NC}"
    echo "  commands/guidelines [list|add|get]  - Manage project guidelines and rules"
    echo "  commands/lessons [list|add|get]     - Manage lessons learned and insights"
    echo "  commands/note [dev-name] [content]  - Add developer notes and observations"
    echo ""
    
    echo -e "${GREEN}❓ HELP & DOCUMENTATION:${NC}"
    echo "  help                       - Show this help message"
    echo "  help [command-name]        - Show detailed help for specific command"
    echo "  help categories            - Show command categories"
    echo "  help examples              - Show usage examples"
    echo ""
    
    echo -e "${MAGENTA}💡 QUICK START:${NC}"
    echo "  ./wake.sh                  # Start your development session"
    echo "  ./save.sh \"progress update\"  # Save your work"
    echo "  ./sleep.sh \"session summary\"  # End your session"
    echo ""
    
    echo -e "${YELLOW}🎯 COGSPACE FEATURES:${NC}"
    echo "  ✅ 90%+ session continuity effectiveness"
    echo "  ✅ Hardware failure protection"
    echo "  ✅ Multi-environment compatibility"
    echo "  ✅ AI semantic file organization"
    echo "  ✅ Complete cognitive context preservation"
}

show_command_help() {
    local cmd="$1"
    
    case "$cmd" in
        "wake.sh"|"session-wake-enhanced.sh")
            echo -e "${CYAN}🌅 SESSION WAKE COMMAND${NC}"
            echo ""
            echo -e "${YELLOW}Purpose:${NC} Start development session with complete cognitive context restoration"
            echo ""
            echo -e "${YELLOW}Usage:${NC}"
            echo "  ./wake.sh"
            echo ""
            echo -e "${YELLOW}Features:${NC}"
            echo "  • Restores complete cognitive context from previous sessions"
            echo "  • Creates quick access commands (guidelines, lessons, note)"
            echo "  • Multi-environment compatibility check"
            echo "  • Hardware failure recovery"
            echo "  • 90%+ continuity effectiveness"
            ;;
            
        "save.sh"|"session-save-enhanced.sh")
            echo -e "${CYAN}💾 SESSION SAVE COMMAND${NC}"
            echo ""
            echo -e "${YELLOW}Purpose:${NC} Save context during active development (hardware failure protection)"
            echo ""
            echo -e "${YELLOW}Usage:${NC}"
            echo "  ./save.sh \"save message\" [work_description] [current_focus] [blocking_issues] [next_actions]"
            echo ""
            echo -e "${YELLOW}Examples:${NC}"
            echo "  ./save.sh \"Fixed login bug\""
            echo "  ./save.sh \"API integration\" \"Working on auth\" \"Database timeout\" \"Test endpoints\""
            echo ""
            echo -e "${YELLOW}Features:${NC}"
            echo "  • AI semantic file organization"
            echo "  • Hardware failure protection"
            echo "  • Complete system state capture"
            echo "  • Quick restore script generation"
            ;;
            
        "sleep.sh"|"session-sleep-enhanced.sh")
            echo -e "${CYAN}😴 SESSION SLEEP COMMAND${NC}"
            echo ""
            echo -e "${YELLOW}Purpose:${NC} Complete session termination with comprehensive context preservation"
            echo ""
            echo -e "${YELLOW}Usage:${NC}"
            echo "  ./sleep.sh \"session summary\""
            echo ""
            echo -e "${YELLOW}Features:${NC}"
            echo "  • AI-generated session summaries"
            echo "  • Complete cognitive context serialization"
            echo "  • Executable continuity scripts"
            echo "  • Performance metrics capture"
            ;;
            
        "help-me-bob")
            echo -e "${CYAN}🚨 TROUBLE REPORTING COMMAND${NC}"
            echo ""
            echo -e "${YELLOW}Purpose:${NC} Create detailed trouble reports for issues, bugs, and problems"
            echo ""
            echo -e "${YELLOW}Usage:${NC}"
            echo "  ./help-me-bob"
            echo ""
            echo -e "${YELLOW}Features:${NC}"
            echo "  • Auto-detects project context"
            echo "  • Generates comprehensive trouble report templates"
            echo "  • Includes technical details, error messages, steps to reproduce"
            echo "  • Impact assessment and severity classification"
            echo "  • Automatic routing to appropriate specialists"
            echo "  • Opens in preferred editor (VS Code, nano, vim)"
            ;;
            
        "update-bob")
            echo -e "${CYAN}📊 PROGRESS REPORTING COMMAND${NC}"
            echo ""
            echo -e "${YELLOW}Purpose:${NC} Report project progress, achievements, and status updates"
            echo ""
            echo -e "${YELLOW}Usage:${NC}"
            echo "  ./update-bob"
            echo ""
            echo -e "${YELLOW}Features:${NC}"
            echo "  • Progress tracking with milestones and achievements"
            echo "  • Challenge identification with blockers and risks"
            echo "  • Next steps planning with immediate actions"
            echo "  • Metrics and KPIs tracking"
            echo "  • Team collaboration updates"
            ;;
            
        "status-bob")
            echo -e "${CYAN}📝 STATUS REPORTING COMMAND${NC}"
            echo ""
            echo -e "${YELLOW}Purpose:${NC} Report system health, deployment status, and performance metrics"
            echo ""
            echo -e "${YELLOW}Usage:${NC}"
            echo "  ./status-bob"
            echo ""
            echo -e "${YELLOW}Features:${NC}"
            echo "  • Health indicators (system health, performance, availability)"
            echo "  • Component status (frontend, backend, database, API, deployment)"
            echo "  • Test results (unit, integration, e2e, performance tests)"
            echo "  • Deployment tracking (environment, version, deployment time)"
            echo "  • Issue tracking (active issues, alerts, resolved issues)"
            ;;
            
        "create-project-bob")
            echo -e "${CYAN}🚀 PROJECT CREATION COMMAND${NC}"
            echo ""
            echo -e "${YELLOW}Purpose:${NC} Create new Crystal Palace projects with proper setup"
            echo ""
            echo -e "${YELLOW}Usage:${NC}"
            echo "  ./create-project-bob                    # Interactive mode (human developers)"
            echo "  ./create-project-bob <name> <owner> <dev>  # Scriptable mode (AI assistants)"
            echo ""
            echo -e "${YELLOW}Features:${NC}"
            echo "  • AI assistant detection for automated vs. interactive modes"
            echo "  • Parameter validation for AI assistants"
            echo "  • Automatic COGSPACE integration"
            echo "  • Project metadata generation"
            ;;
            
        "guidelines")
            echo -e "${CYAN}📋 GUIDELINES MANAGEMENT COMMAND${NC}"
            echo ""
            echo -e "${YELLOW}Purpose:${NC} Manage project guidelines, rules, and standards"
            echo ""
            echo -e "${YELLOW}Usage:${NC}"
            echo "  ./guidelines list                      # List all guidelines"
            echo "  ./guidelines add \"name\" \"content\"     # Add new guideline"
            echo "  ./guidelines get \"name\"               # Get specific guideline"
            echo ""
            echo -e "${YELLOW}Examples:${NC}"
            echo "  ./guidelines add \"coding-standards\" \"Use TypeScript for new features\""
            echo "  ./guidelines list"
            ;;
            
        "lessons")
            echo -e "${CYAN}📚 LESSONS LEARNED MANAGEMENT COMMAND${NC}"
            echo ""
            echo -e "${YELLOW}Purpose:${NC} Manage lessons learned and insights"
            echo ""
            echo -e "${YELLOW}Usage:${NC}"
            echo "  ./lessons list                         # List all lessons"
            echo "  ./lessons add \"name\" \"content\"        # Add new lesson"
            echo "  ./lessons get \"name\"                  # Get specific lesson"
            echo ""
            echo -e "${YELLOW}Examples:${NC}"
            echo "  ./lessons add \"performance-tip\" \"Cache API responses for 5min\""
            echo "  ./lessons list"
            ;;
            
        "note")
            echo -e "${CYAN}📝 DEVELOPER NOTES COMMAND${NC}"
            echo ""
            echo -e "${YELLOW}Purpose:${NC} Quick capture of developer notes and observations"
            echo ""
            echo -e "${YELLOW}Usage:${NC}"
            echo "  ./note \"developer-name\" \"note-content\""
            echo ""
            echo -e "${YELLOW}Examples:${NC}"
            echo "  ./note \"Bob\" \"Database schema needs normalization\""
            echo "  ./note \"Howard\" \"API endpoint returning 500 errors\""
            ;;
            
        *)
            echo -e "${RED}❌ Unknown command: $cmd${NC}"
            echo ""
            echo -e "${YELLOW}Available commands:${NC}"
            echo "  wake.sh, save.sh, sleep.sh, help-me-bob, update-bob, status-bob,"
            echo "  create-project-bob, guidelines, lessons, note"
            ;;
    esac
}

show_categories() {
    echo -e "${CYAN}📂 COMMAND CATEGORIES${NC}"
    echo ""
    
    echo -e "${GREEN}🔧 Session Management:${NC}"
    echo "  wake.sh, save.sh, sleep.sh"
    echo "  Purpose: Manage development sessions with cognitive continuity"
    echo ""
    
    echo -e "${GREEN}📊 Reporting & Tracking:${NC}"
    echo "  help-me-bob, update-bob, status-bob"
    echo "  Purpose: Report issues, progress, and system status"
    echo ""
    
    echo -e "${GREEN}🏗️ Project Management:${NC}"
    echo "  create-project-bob"
    echo "  Purpose: Create new projects with proper setup"
    echo ""
    
    echo -e "${GREEN}📚 Knowledge Management:${NC}"
    echo "  guidelines, lessons, note"
    echo "  Purpose: Capture and manage project knowledge"
    echo ""
    
    echo -e "${GREEN}❓ Help & Documentation:${NC}"
    echo "  help"
    echo "  Purpose: Get help and documentation"
}

show_examples() {
    echo -e "${CYAN}💡 USAGE EXAMPLES${NC}"
    echo ""
    
    echo -e "${YELLOW}🌅 Starting a Development Session:${NC}"
    echo "  ./wake.sh"
    echo "  # Restores your previous context and creates quick access commands"
    echo ""
    
    echo -e "${YELLOW}💾 Saving Your Work:${NC}"
    echo "  ./save.sh \"Fixed the login bug\""
    echo "  ./save.sh \"API integration\" \"Working on authentication\" \"Database timeout\" \"Test endpoints\""
    echo ""
    
    echo -e "${YELLOW}😴 Ending Your Session:${NC}"
    echo "  ./sleep.sh \"Completed API integration and fixed login issues\""
    echo ""
    
    echo -e "${YELLOW}🚨 Reporting an Issue:${NC}"
    echo "  ./help-me-bob"
    echo "  # Opens trouble report template in your editor"
    echo ""
    
    echo -e "${YELLOW}📊 Reporting Progress:${NC}"
    echo "  ./update-bob"
    echo "  # Opens progress report template in your editor"
    echo ""
    
    echo -e "${YELLOW}📝 Adding Knowledge:${NC}"
    echo "  ./guidelines add \"deployment\" \"Always test on staging before production\""
    echo "  ./lessons add \"performance\" \"Database queries need indexing\""
    echo "  ./note \"Bob\" \"Need to refactor authentication module\""
    echo ""
    
    echo -e "${YELLOW}🚀 Creating a New Project:${NC}"
    echo "  ./create-project-bob"
    echo "  # Interactive project creation with prompts"
    echo ""
    
    echo -e "${YELLOW}❓ Getting Help:${NC}"
    echo "  ./help                    # Show all commands"
    echo "  ./help save.sh           # Show detailed help for save command"
    echo "  ./help categories        # Show command categories"
    echo "  ./help examples          # Show usage examples"
}

# Main help logic
case "$1" in
    "categories")
        show_categories
        ;;
    "examples")
        show_examples
        ;;
    "")
        show_main_help
        ;;
    *)
        show_command_help "$1"
        ;;
esac 
