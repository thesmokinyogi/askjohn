# COGSPACE v55.0.0 - New Project Creation
# v55.0.0: Fixed symlink resolution for PROJECT_ROOT calculation + dynamic versioning
# v51.6.0: Updated all commands to v51.6.0
# v50.0.0 FIX: Check cogspace-version.json instead of deprecated .version file
# Enhanced Crystal Palace Project Creation System with AITCL integration
# Supports both interactive (human) and scriptable (AI/automation) modes

set -euo pipefail

# Color definitions
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
MAGENTA='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# Resolve symlink before calculating paths
SCRIPT_PATH="${BASH_SOURCE[0]}"
if [[ -L "$SCRIPT_PATH" ]]; then
    SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"
    if [[ "$SCRIPT_PATH" != /* ]]; then
        SCRIPT_PATH="$(dirname "${BASH_SOURCE[0]}")/$SCRIPT_PATH"
    fi
fi
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"

# Configuration
TIMESTAMP=$(date -u +"%Y-%m-%dT%H:%M:%S.%3NZ")

# Read version dynamically - NEVER hardcode!
NEW_PROJECT_VERSION=$(jq -r '.version // "55.0.0"' "$SCRIPT_DIR/../cogspace-version.json" 2>/dev/null || echo "55.0.0")

# DNA Source Resolution (v35.0.0+ architecture)
# Tiered fallback: Crystal Palace → GitHub → Cache → Standalone
COGSPACE_DNA_REPO="howeirdo/cogspace-remote-dna"
COGSPACE_DNA_CACHE="$HOME/.cogspace/dna"
COGSPACE_MODE="unknown"
DNA_SOURCE=""

resolve_dna_source() {
    # Tier 1: Crystal Palace Local (legacy - for transition period)
    if [[ -d "/Volumes/FOUR-TB/cogspace-dna-source/current" ]]; then
        DNA_SOURCE="/Volumes/FOUR-TB/cogspace-dna-source/current"
        COGSPACE_MODE="crystal-palace"
        return 0
    fi

    # Tier 2: Update from GitHub if possible, then use cache
    if command -v gh &>/dev/null && gh auth status &>/dev/null 2>&1; then
        mkdir -p "$COGSPACE_DNA_CACHE"
        if [[ -d "$COGSPACE_DNA_CACHE/.git" ]]; then
            # Update existing cache silently
            git -C "$COGSPACE_DNA_CACHE" pull --quiet 2>/dev/null || true
        else
            # Fresh clone
            gh repo clone "$COGSPACE_DNA_REPO" "$COGSPACE_DNA_CACHE" --depth 1 2>/dev/null || true
        fi
    fi

    # Tier 3: Use cached DNA (whether just updated or from previous session)
    # v50.0.0: Check cogspace-version.json instead of deprecated .version file
    if [[ -f "$COGSPACE_DNA_CACHE/cogspace/cogspace-version.json" ]]; then
        DNA_SOURCE="$COGSPACE_DNA_CACHE"
        COGSPACE_MODE="portable"
        return 0
    fi

    # Tier 4: No DNA available - standalone mode
    DNA_SOURCE=""
    COGSPACE_MODE="standalone"
    return 1
}

# Resolve DNA source first
resolve_dna_source || true

# Set COGSPACE_DIR from resolved DNA_SOURCE
COGSPACE_DIR="${DNA_SOURCE:-$SCRIPT_DIR/..}"

# Dynamic project root detection
# Priority: CLI argument → Crystal Palace (if available) → User's home/projects
detect_project_root() {
    # If Crystal Palace exists, use it as default
    if [[ -d "/Volumes/FOUR-TB/root" ]]; then
        echo "/Volumes/FOUR-TB/root"
    else
        # Portable mode: use ~/projects
        local portable_root="$HOME/projects"
        mkdir -p "$portable_root" 2>/dev/null || true
        echo "$portable_root"
    fi
}

CRYSTAL_PALACE_ROOT="$(detect_project_root)"

# Show mode indicator
show_mode_indicator() {
