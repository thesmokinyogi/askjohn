# Function: Validate project name
validate_project_name() {
    local name="$1"
    
    # Check for valid characters (alphanumeric, hyphens, underscores)
    if [[ ! "$name" =~ ^[a-zA-Z0-9_-]+$ ]]; then
        echo -e "${RED}❌ Invalid project name. Use only letters, numbers, hyphens, and underscores.${NC}"
        return 1
    fi
    
    # Check if project already exists
    if [[ -d "$CRYSTAL_PALACE_ROOT/$name" ]]; then
        echo -e "${RED}❌ Project already exists: $CRYSTAL_PALACE_ROOT/$name${NC}"
        return 1
    fi
    
    # Check length
    if [[ ${#name} -lt 3 || ${#name} -gt 50 ]]; then
        echo -e "${RED}❌ Project name must be between 3 and 50 characters.${NC}"
        return 1
    fi
    
    return 0
}

# Function: Interactive project creation
interactive_mode() {
    echo -e "${CYAN}🎯 INTERACTIVE PROJECT CREATION${NC}"
    echo -e "${BLUE}Creating a new Crystal Palace project with COGSPACE integration${NC}"
    echo ""
    
    # Project name
    while true; do
        echo -e "${YELLOW}📝 Enter project name (kebab-case recommended):${NC}"
        read -r PROJECT_NAME
        if validate_project_name "$PROJECT_NAME"; then
            echo -e "${GREEN}✅ Project name valid: $PROJECT_NAME${NC}"
            break
        fi
    done
    
    # Project owner
    echo ""
    echo -e "${YELLOW}👤 Enter project owner (default: Crystal Palace):${NC}"
    read -r PROJECT_OWNER
    PROJECT_OWNER="${PROJECT_OWNER:-Crystal Palace}"
    
    # Primary developer
    echo ""
    echo -e "${YELLOW}👨‍💻 Enter primary developer (default: Howard Fried):${NC}"
    read -r PRIMARY_DEV
    PRIMARY_DEV="${PRIMARY_DEV:-Howard Fried}"
    
    # Project type selection
    echo ""
    echo -e "${CYAN}🏗️ Select project type:${NC}"
    for i in "${!PROJECT_TYPE_NAMES[@]}"; do
        local index=$((i + 1))
        echo "  $index) ${PROJECT_TYPE_NAMES[$i]} - ${PROJECT_TYPE_DESCRIPTIONS[$i]}"
    done
    
    echo ""
    echo -e "${YELLOW}Enter selection (1-${#PROJECT_TYPE_NAMES[@]}, default: ${#PROJECT_TYPE_NAMES[@]} for generic):${NC}"
    read -r SELECTION
    SELECTION="${SELECTION:-${#PROJECT_TYPE_NAMES[@]}}"
    
    if [[ "$SELECTION" =~ ^[0-9]+$ ]] && [[ "$SELECTION" -ge 1 ]] && [[ "$SELECTION" -le "${#PROJECT_TYPE_NAMES[@]}" ]]; then
        local selected_index=$((SELECTION - 1))
        PROJECT_TYPE="${PROJECT_TYPE_NAMES[$selected_index]}"
        echo -e "${GREEN}✅ Selected: $PROJECT_TYPE${NC}"
    else
        PROJECT_TYPE="generic"
        echo -e "${YELLOW}⚠️ Invalid selection, using generic project type${NC}"
    fi
    
    # Project description
    echo ""
    echo -e "${YELLOW}📄 Enter project description (optional):${NC}"
    read -r PROJECT_DESCRIPTION
    PROJECT_DESCRIPTION="${PROJECT_DESCRIPTION:-A Crystal Palace project with cognitive workspace serialization}"
    
    # Confirmation
    echo ""
    echo -e "${CYAN}📋 PROJECT CONFIGURATION SUMMARY:${NC}"
    echo -e "${BLUE}  Name: $PROJECT_NAME${NC}"
    echo -e "${BLUE}  Owner: $PROJECT_OWNER${NC}"
    echo -e "${BLUE}  Developer: $PRIMARY_DEV${NC}"
    echo -e "${BLUE}  Type: $PROJECT_TYPE${NC}"
    echo -e "${BLUE}  Description: $PROJECT_DESCRIPTION${NC}"
    echo -e "${BLUE}  Location: $CRYSTAL_PALACE_ROOT/$PROJECT_NAME${NC}"
    echo ""
    
    echo -e "${YELLOW}🚀 Proceed with project creation? (Y/n):${NC}"
    read -r CONFIRM
    CONFIRM="${CONFIRM:-Y}"
    
    if [[ ! "$CONFIRM" =~ ^[Yy]$ ]]; then
        echo -e "${YELLOW}❌ Project creation cancelled${NC}"
        exit 0
    fi
}

# Function: Scriptable project creation
scriptable_mode() {
    echo -e "${CYAN}🤖 SCRIPTABLE PROJECT CREATION${NC}"
    echo -e "${BLUE}AI/Automation mode with parameter validation${NC}"
    echo ""
    
    # Validate parameter count
    if [[ "$#" -lt 3 ]]; then
        echo -e "${RED}❌ ERROR: Insufficient parameters for scriptable mode${NC}"
        show_usage
        exit 1
    fi
    
    # Extract parameters
    PROJECT_NAME="$1"
    PROJECT_OWNER="$2"
    PRIMARY_DEV="$3"
    PROJECT_TYPE="${4:-generic}"
    PROJECT_DESCRIPTION="${5:-A Crystal Palace project with cognitive workspace serialization}"
    
    # Validate project name
    if ! validate_project_name "$PROJECT_NAME"; then
        exit 1
    fi
    
    # Validate project type
    local valid_type=false
    for type in "${PROJECT_TYPE_NAMES[@]}"; do
        if [[ "$type" == "$PROJECT_TYPE" ]]; then
            valid_type=true
            break
        fi
    done
    
    if [[ "$valid_type" == false ]]; then
        echo -e "${YELLOW}⚠️ Unknown project type '$PROJECT_TYPE', using 'generic'${NC}"
        PROJECT_TYPE="generic"
    fi
    
    echo -e "${GREEN}✅ Parameters validated${NC}"
    echo -e "${BLUE}  Name: $PROJECT_NAME${NC}"
    echo -e "${BLUE}  Owner: $PROJECT_OWNER${NC}"
    echo -e "${BLUE}  Developer: $PRIMARY_DEV${NC}"
    echo -e "${BLUE}  Type: $PROJECT_TYPE${NC}"
    echo ""
}

