    # Check if DNA source is available
    if [[ -z "$DNA_SOURCE" ]]; then
        echo -e "${RED}❌ No DNA source available - cannot deploy COGSPACE${NC}"
        echo -e "${YELLOW}Please ensure GitHub CLI is installed and authenticated:${NC}"
        echo -e "${CYAN}  brew install gh && gh auth login${NC}"
        exit 1
    fi

    # Try deployment scripts in order of preference
    local deployment_scripts=(
        "$DNA_SOURCE/src/deploy-cogspace.sh"
        "$DNA_SOURCE/deploy-cogspace.sh"
        "$DNA_SOURCE/deploy-v16-single.sh"
    )

    local deployed=false
    for script in "${deployment_scripts[@]}"; do
        if [[ -f "$script" ]]; then
            echo -e "${YELLOW}🔧 Running deployment: $(basename "$script")...${NC}"
            "$script" "$project_path" && deployed=true && break
        fi
    done

    if [[ "$deployed" == false ]]; then
        echo -e "${YELLOW}⚠️ No deployment script found, using direct copy...${NC}"
        # Direct copy fallback - v40.2.1 minimalist structure
        if [[ -d "$DNA_SOURCE/cogspace" ]]; then
            cp -r "$DNA_SOURCE/cogspace" "$project_path/"
            # v40.2.1: Don't copy src/ directory - not needed for projects
            # cp -r "$DNA_SOURCE/src" "$project_path/" 2>/dev/null || true

            # Create symlinks
            cd "$project_path"
            ln -sf cogspace/core/session-wake.sh wake.sh
            ln -sf cogspace/core/session-sleep.sh sleep.sh
            ln -sf cogspace/core/session-save.sh save.sh
            ln -sf cogspace/core/session-wake.sh hi
            ln -sf cogspace/core/session-sleep.sh bye
            ln -sf cogspace/core/session-save.sh save

            # v40.2.1: Don't copy .version file - use cogspace/cogspace-version.json
            # cp "$DNA_SOURCE/.version" "$project_path/" 2>/dev/null || echo "35.2.0" > "$project_path/.version"

            echo -e "${GREEN}✅ Direct copy deployment complete${NC}"
            deployed=true
        fi
    fi

    if [[ "$deployed" == false ]]; then
        echo -e "${RED}❌ Deployment failed - no cogspace directory in DNA source${NC}"
        exit 1
    fi

    echo -e "${GREEN}✅ COGSPACE v${NEW_PROJECT_VERSION} deployment complete (${COGSPACE_MODE} mode)${NC}"
}

# Function: Validate project creation
validate_project_creation() {
    echo -e "${CYAN}🔍 VALIDATING PROJECT CREATION${NC}"
    
    local project_path="$CRYSTAL_PALACE_ROOT/$PROJECT_NAME"
    local validation_errors=0
    
    # v40.2.1: Check minimalist essential files only
    # AITCL and extra docs are optional, not required
    local essential_files=(
        "README.md"
        ".gitignore"
        ".claude/CLAUDE.md"
        "cogspace/cogspace-version.json"
        "wake.sh"
        "save.sh"
        "sleep.sh"
        "hi"
        "bye"
        "save"
    )
    
    for file in "${essential_files[@]}"; do
        if [[ -f "$project_path/$file" ]]; then
            echo -e "${GREEN}✅ $file${NC}"
        else
            echo -e "${RED}❌ $file${NC}"
            ((validation_errors++))
        fi
    done
    
    # v40.2.1: Check symlinks (hi, bye, save should be symlinks)
    local symlinks=("hi" "bye" "save")
    for link in "${symlinks[@]}"; do
        if [[ -L "$project_path/$link" ]]; then
            echo -e "${GREEN}✅ $link (symlink)${NC}"
        else
            echo -e "${YELLOW}⚠️ $link (not a symlink)${NC}"
        fi
    done

    # Check COGSPACE functionality
    cd "$project_path"
    if ./wake.sh > /dev/null 2>&1; then
        echo -e "${GREEN}✅ COGSPACE v${NEW_PROJECT_VERSION} functionality operational${NC}"
    else
        echo -e "${RED}❌ COGSPACE v${NEW_PROJECT_VERSION} functionality check failed${NC}"
        ((validation_errors++))
    fi
    
    # Generate validation report
    local validation_status="SUCCESS"
    if [[ $validation_errors -gt 0 ]]; then
        validation_status="FAILED"
    fi
    
    local validation_report=$(cat << EOF
{
  "projectCreation": {
    "timestamp": "$TIMESTAMP",
    "projectName": "$PROJECT_NAME",
    "status": "$validation_status",
    "validationErrors": $validation_errors
  },
  "cogspaceIntegration": {
    "deployed": true,
    "functional": $(if [[ $validation_errors -eq 0 ]]; then echo "true"; else echo "false"; fi),
    "continuityTarget": "90%+"
  },
  "readyForDevelopment": $(if [[ $validation_errors -eq 0 ]]; then echo "true"; else echo "false"; fi)
}
EOF
)
    
    # v40.2.1: Don't create validation JSON file - minimalist structure
    # echo "$validation_report" > "$project_path/project-creation-validation.json"
    # chmod 644 "$project_path/project-creation-validation.json"
    
    if [[ $validation_errors -eq 0 ]]; then
        echo -e "${GREEN}✅ PROJECT VALIDATION COMPLETE${NC}"
        return 0
    else
        echo -e "${RED}❌ PROJECT VALIDATION FAILED ($validation_errors errors)${NC}"
        return 1
    fi
}

# Main execution flow
main() {
    # Show usage if requested
    if [[ "${1:-}" =~ ^(-h|--help|help)$ ]]; then
        show_usage
        exit 0
    fi
    
    # Execute based on mode
    if [[ "$EXECUTION_MODE" == "interactive" ]]; then
        interactive_mode
    else
        scriptable_mode "$@"
    fi
    
    # Create the project
    echo ""
    echo -e "${MAGENTA}🚀 BEGINNING PROJECT CREATION SEQUENCE${NC}"
    
    create_project_structure
    generate_project_files
    # v40.2.1: AITCL templates disabled - minimalist structure
    # AITCL can be added manually if needed: ./cogspace/commands/add-aitcl
    # deploy_aitcl_templates
    deploy_cogspace_integration
    
    echo ""
    if validate_project_creation; then
        echo ""
        echo -e "${GREEN}✅ PROJECT CREATION COMPLETE${NC}"
        echo -e "${CYAN}🏛️ CRYSTAL PALACE PROJECT: $PROJECT_NAME${NC}"
        echo ""
        echo -e "${BLUE}📍 Location: $CRYSTAL_PALACE_ROOT/$PROJECT_NAME${NC}"
        echo -e "${BLUE}🧠 COGSPACE Version: ${NEW_PROJECT_VERSION} - Portable Mode${NC}"
        show_mode_indicator
        echo -e "${BLUE}🎯 Continuity Effectiveness: 90%+${NC}"
        echo ""
        echo -e "${YELLOW}🚀 IMMEDIATE NEXT STEPS:${NC}"
        echo -e "${CYAN}  1. cd $CRYSTAL_PALACE_ROOT/$PROJECT_NAME${NC}"
        echo -e "${CYAN}  2. ./wake.sh  (or just: hi)${NC}"
        echo -e "${CYAN}  3. Begin development with revolutionary context preservation${NC}"
        echo ""
        echo -e "${MAGENTA}🎯 COGNITIVE WORKSPACE SERIALIZATION: ACTIVE${NC}"
        echo -e "${BLUE}🌐 DNA Source: ${DNA_SOURCE:-standalone}${NC}"
    else
        echo ""
        echo -e "${RED}❌ PROJECT CREATION FAILED${NC}"
        echo -e "${YELLOW}Check validation report for details${NC}"
        exit 1
    fi
}

# Run main function with all arguments
main "$@"
