# Function: Deploy AITCL templates
deploy_aitcl_templates() {
    echo -e "${CYAN}📚 DEPLOYING AITCL TEMPLATES${NC}"
    echo -e "${BLUE}Deploying AI Task Control Language documentation and templates${NC}"
    
    local project_path="$CRYSTAL_PALACE_ROOT/$PROJECT_NAME"
    
    # Determine which AITCL template to use based on project type
    local aitcl_template=""
    case "$PROJECT_TYPE" in
        "ai-assistant")
            aitcl_template="ai-assistant.aitcl.md"
            ;;
        "web-app"|"dashboard")
            aitcl_template="web-app.aitcl.md"
            ;;
        *)
            aitcl_template="basic-project.aitcl.md"
            ;;
    esac
    
    # Create AITCL directories
    mkdir -p "$project_path/docs/aitcl"
    mkdir -p "$project_path/templates/aitcl"
    
    # Deploy AITCL documentation (all docs for reference)
    if [[ -d "$COGSPACE_DIR/docs/aitcl" ]]; then
        echo -e "${YELLOW}📖 Deploying AITCL documentation suite...${NC}"
        cp -r "$COGSPACE_DIR/docs/aitcl"/* "$project_path/docs/aitcl/" || {
            echo -e "${RED}❌ AITCL documentation deployment failed${NC}"
            return 1
        }
    fi
    
    # Deploy project-specific AITCL template
    if [[ -f "$COGSPACE_DIR/templates/aitcl/$aitcl_template" ]]; then
        echo -e "${YELLOW}📋 Deploying $PROJECT_TYPE AITCL template...${NC}"
        
        # Copy and customize the template
        local customized_template="$project_path/templates/aitcl/${PROJECT_NAME}.aitcl.md"
        cp "$COGSPACE_DIR/templates/aitcl/$aitcl_template" "$customized_template"
        
        # Replace template variables
        sed -i '' "s/\[Project Name\]/$PROJECT_NAME/g" "$customized_template"
        sed -i '' "s/\[project-name\]/$PROJECT_NAME/g" "$customized_template"
        sed -i '' "s/\[DATE\]/$TIMESTAMP/g" "$customized_template"
        sed -i '' "s/\[OWNER NAME\]/$PROJECT_OWNER/g" "$customized_template"
        sed -i '' "s/\[DEVELOPER NAME\]/$PRIMARY_DEV/g" "$customized_template"
        sed -i '' "s/\[SESSION-ID\]/$(date +%s)-$(openssl rand -hex 4)/g" "$customized_template"
        
        echo -e "${GREEN}✅ AITCL template customized: ${customized_template}${NC}"
    else
        echo -e "${YELLOW}⚠️  AITCL template not found: $aitcl_template, using basic template${NC}"
        # Fallback to basic template
        if [[ -f "$COGSPACE_DIR/templates/aitcl/basic-project.aitcl.md" ]]; then
            cp "$COGSPACE_DIR/templates/aitcl/basic-project.aitcl.md" "$project_path/templates/aitcl/${PROJECT_NAME}.aitcl.md"
        fi
    fi
    
    echo -e "${GREEN}✅ AITCL templates deployed successfully${NC}"
}

