#!/bin/bash
# COGSPACE v55.0.0 - Lessons Learned Management
# Track lessons learned during development
# v51.6.0: Fixed multi-line content handling via JSON encoding
# v55.0.0: Fixed symlink resolution for PROJECT_ROOT calculation

# Resolve symlink before calculating PROJECT_ROOT
SCRIPT_PATH="${BASH_SOURCE[0]}"
if [[ -L "$SCRIPT_PATH" ]]; then
    # Resolve symlink to actual script location
    SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"
    # Handle relative symlinks
    if [[ "$SCRIPT_PATH" != /* ]]; then
        SCRIPT_PATH="$(dirname "${BASH_SOURCE[0]}")/$SCRIPT_PATH"
    fi
fi
PROJECT_ROOT="$(cd "$(dirname "$SCRIPT_PATH")/../.." && pwd)"
cd "$PROJECT_ROOT"

# Read version dynamically - NEVER hardcode!
VERSION=$(jq -r '.version // "unknown"' "$PROJECT_ROOT/cogspace/cogspace-version.json" 2>/dev/null || echo "unknown")

case "$1" in
    "list")
        node -e "const s=require('./cogspace/analyzers/serializer.cjs'); (async()=>console.log(await new s().manageLessons('list')))()"
        ;;
    "add")
        if [[ -z "$2" ]] || [[ -z "$3" ]]; then
            echo "Usage: lessons add <name> <content>"
            echo ""
            echo "Example: lessons add 'async-handling' 'Always use try-catch with async/await'"
            echo "Example: lessons add 'debugging' \"Multi-line"
            echo "  lesson content\""
            exit 1
        fi
        LESSON_NAME="$2"
        shift 2
        LESSON_CONTENT="$*"

        # v51.6.0: Use JSON encoding to safely pass multi-line content
        if command -v jq &>/dev/null; then
            JSON_PAYLOAD=$(jq -n \
                --arg name "$LESSON_NAME" \
                --arg content "$LESSON_CONTENT" \
                '{name: $name, content: $content}')

            echo "$JSON_PAYLOAD" | node -e "
const s = require('./cogspace/analyzers/serializer.cjs');
let data = '';
process.stdin.setEncoding('utf8');
process.stdin.on('data', chunk => data += chunk);
process.stdin.on('end', async () => {
    try {
        const parsed = JSON.parse(data);
        await new s().manageLessons('add', parsed.name, parsed.content);
    } catch (e) {
        console.error('Error adding lesson:', e.message);
        process.exit(1);
    }
});
"
        else
            # Fallback: Write content to temp file
            TEMP_FILE=$(mktemp)
            echo "$LESSON_CONTENT" > "$TEMP_FILE"

            node -e "
const s = require('./cogspace/analyzers/serializer.cjs');
const fs = require('fs');
(async () => {
    try {
        const content = fs.readFileSync('$TEMP_FILE', 'utf8');
        await new s().manageLessons('add', '$LESSON_NAME', content);
    } catch (e) {
        console.error('Error adding lesson:', e.message);
        process.exit(1);
    }
})();
"
            rm -f "$TEMP_FILE"
        fi
        echo "✅ Lesson added: $LESSON_NAME"
        ;;
    "get")
        if [[ -z "$2" ]]; then
            echo "Usage: lessons get <name>"
            exit 1
        fi
        # Name escaping is safe - single line, no special chars typically
        ESCAPED_NAME=$(echo "$2" | sed "s/'/\\\\'/g")
        node -e "const s=require('./cogspace/analyzers/serializer.cjs'); (async()=>console.log(await new s().manageLessons('get','${ESCAPED_NAME}')))()"
        ;;
    "help"|"--help"|"-h")
        echo "COGSPACE v$VERSION - Lessons Learned Management"
        echo ""
        echo "Usage: lessons [command] [options]"
        echo ""
        echo "Commands:"
        echo "  list                      List all lessons"
        echo "  add <name> <content>      Add new lesson"
        echo "  get <name>                Get specific lesson"
        echo "  help                      Show this help message"
        echo ""
        echo "Examples:"
        echo "  lessons list"
        echo "  lessons add 'async-handling' 'Always use try-catch with async/await'"
        echo "  lessons add 'debugging' \"Multi-line"
        echo "    lesson with 'quotes'\""
        echo "  lessons get 'async-handling'"
        ;;
    *)
        echo "COGSPACE v$VERSION - Lessons Learned Management"
        echo ""
        echo "Usage: lessons [command] [options]"
        echo ""
        echo "Commands:"
        echo "  list                      List all lessons"
        echo "  add <name> <content>      Add new lesson"
        echo "  get <name>                Get specific lesson"
        echo "  help                      Show this help message"
        ;;
esac
