# Voice-to-Text V2 Configuration
# Updated: 2025-11-09 - Provider abstraction architecture

# ============================================
# TRANSCRIPTION PROVIDER (STRATEGIC)
# ============================================
# Which transcription service to use
STT_PROVIDER=google

# ============================================
# GOOGLE CLOUD CONFIGURATION (TACTICAL)
# ============================================

# Authentication
GOOGLE_APPLICATION_CREDENTIALS=/Users/johncarosella/Documents/GitHub/credentials/google-cloud-key.json

# Project ID
GOOGLE_CLOUD_PROJECT=voice-to-text-dev

# Cloud Storage Bucket
GCS_BUCKET_NAME=voice-to-text-audio-jc

# Model Selection
# Options: long (recommended), chirp_3 (best accuracy), short (clips)
# Cost: long=$0.024/min, chirp_3=$0.064/min
GOOGLE_MODEL=long
